---
import Layout from '../../layouts/Layout.astro';

// Fetch upcoming courses from Airtable
const API_KEY = import.meta.env.AIRTABLE_API_KEY;
const BASE_ID = import.meta.env.AIRTABLE_BASE_ID;
const TABLE = encodeURIComponent('קורסים פרונטליים');
const VIEW = encodeURIComponent('יועצי בריאות');

let courses = [];

try {
    const url = `https://api.airtable.com/v0/${BASE_ID}/${TABLE}?view=${VIEW}`;
    const response = await fetch(url, {
        headers: {
            Authorization: `Bearer ${API_KEY}`
        }
    });

    if (!response.ok) {
        throw new Error(`HTTP status ${response.status}`);
    }

    const data = await response.json();
    courses = data.records;
} catch (error) {
    // Log error with variables liable to cause it
    console.error("Failed to fetch NLP courses from Airtable", { error, BASE_ID, TABLE, VIEW });
}

// Format date from YYYY-MM-DD to DD.MM.YYYY
const formatDate = (dateString) => {
    if (!dateString) return '';
    const [year, month, day] = dateString.split('-');
    return `${day}.${month}.${year}`;
};
---

<Layout title="קורס יועצי בריאות במגמת תזונה ו-NLP - מכון וקסלר">
    <section class="bg-blue-900 text-white py-20 text-center relative overflow-hidden">
        <div class="absolute inset-0 opacity-20 bg-cover bg-center" style="background-image: url('/images/courses/יועצי בריאות פרונטלי.jpg`}');"></div>
        <div class="container mx-auto px-4 relative z-10 max-w-5xl">
            <div class="inline-block bg-white text-blue-900 font-bold px-6 py-2 rounded-full mb-6 text-sm">הכשרה מקצועית מקיפה</div>
            <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold mb-6 text-teal-400">קורס יועצי בריאות במגמת תזונה ו-NLP</h1>
            <p class="text-xl md:text-2xl mb-8 leading-relaxed max-w-4xl mx-auto font-medium text-white p-4 rounded-xl shadow-md" style="background-color: rgba(31, 41, 55, 0.8);">
                הדרך שלכם להפוך למאמנים מובילים המעניקים ערך ייחודי. שילוב מנצח של תזונה, שינוי הרגלים ותמיכה מנטלית בעזרת כלי NLP.
            </p>
            <a href="#contact-us" class="inline-block bg-teal-500 hover:bg-teal-400 text-white font-bold text-xl py-4 px-16 min-w-[300px] rounded-full shadow-lg transform hover:-translate-y-1 transition duration-300">
                לפרטים והרשמה לחצו כאן
            </a>
            
            {courses.length > 0 && (
                <div class="mt-12 max-w-3xl mx-auto space-y-4">
                    {courses.map((course) => (
                        <div class="bg-white/10 backdrop-blur-md border border-white/20 p-8 rounded-2xl text-lg text-white shadow-xl hover:bg-white/15 transition duration-300">
                            <h3 class="text-2xl font-bold text-teal-300 mb-4 drop-shadow-md">
                                <span aria-hidden="true">✨</span> מחזור חדש ייפתח ב-{formatDate(course.fields['תאריך פתיחה'])}!
                            </h3>
                            <p class="mb-2 text-xl font-light">
                                הקורס יתקיים בימי {course.fields['יום בשבוע']} בין השעות {course.fields['שעות הקורס']} ב{course.fields['מיקום']}
                            </p>
                            {course.fields['הערות נוספות'] && (
                                <p class="text-teal-200 font-medium">
                                    <span aria-hidden="true">💡</span> {course.fields['הערות נוספות']}
                                </p>
                            )}
                        </div>
                    ))}
                </div>
            )}
        </div>
    </section>

    <section class="py-16 bg-white">
        <div class="container mx-auto px-4 max-w-6xl grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
            <div class="space-y-6">
                <h2 class="text-3xl lg:text-4xl font-bold text-blue-900 mb-4">בואו נדבר על אוכל בשפה אחרת</h2>
                <p class="text-lg text-gray-800 leading-relaxed">
                    כמה חשוב לך להיות המאמן שמעניק למתאמנים שלו ערך ייחודי ובלתי מתפשר – כזה שמשלב בין תזונה, מוטיבציה והרגלים לחיים בריאים ומאוזנים?
                </p>
                <p class="text-lg text-gray-800 leading-relaxed">
                    היית רוצה ללמוד ביסודיות איך ליצור שינוי אמיתי, לא רק בגוף אלא גם בתודעה של הלקוחות שלך – ולעזור להם להתמיד ולהגיע לתוצאות שיחזיקו לאורך זמן?
                </p>
                <hr class="border-gray-200 my-6">
                <h3 class="text-2xl font-bold text-teal-600">עכשיו זה הזמן שלך להתפתח ולהתמקצע</h3>
                <p class="text-gray-700 leading-relaxed">
                    תוכנית ההכשרה שלנו מיועדת במיוחד למאמני כושר כמו יוגה ופילאטיס, וגם לאנשים שרוצים לפתוח קריירה חדשה בתחום התזונה והאכילה הרגשית. אנחנו ניתן לך את המרכיב הסודי שיגרום לך לבלוט מעל כולם.
                </p>
            </div>
            <div>
                <<img src={`${import.meta.env.BASE_URL}images/frontal/nutrition1.jpg`}" alt="תזונה בריאה" class="rounded-2xl shadow-2xl w-full object-cover">
            </div>
        </div>
    </section>

    <section class="py-16 bg-gray-50 border-y border-gray-200">
        <div class="container mx-auto px-4 max-w-6xl">
            <h2 class="text-3xl md:text-4xl font-bold text-center text-blue-900 mb-12">מה תקבלו בקורס?</h2>
