---
import Layout from '../../layouts/Layout.astro';
---
<Layout title="יועצי בריאות מגמת תזונה ו-NLP - מכון וקסלר">
    <!-- Hero Section -->
    <section class="bg-blue-900 text-white py-20 text-center relative">
        <div class="container mx-auto px-4 relative z-10 max-w-5xl">
            <div class="inline-block bg-yellow-500 text-blue-900 font-bold px-6 py-2 rounded-full mb-6">לראשונה: תזונה ומוטיבציה במקום אחד</div>
            <h1 class="text-5xl md:text-6xl font-bold mb-6 text-white">יועצי בריאות במגמת תזונה ו-NLP</h1>
            <p class="text-2xl mb-8 leading-relaxed max-w-4xl mx-auto font-light">
                כמה חשוב לך להיות המאמן שמעניק ערך ייחודי ובלתי מתפשר? כזה שמשלב בין תזונה, מוטיבציה והרגלים לחיים בריאים? הגיע הזמן לדבר על אוכל בשפה אחרת!
            </p>
            <div class="flex flex-col sm:flex-row gap-6 justify-center mt-10">
                <!-- כפתורים מורחבים ומרווחים -->
                <a href="https://secure.cardcom.solutions/EA/EA5/FVNYwke6DU6l3QQWv5kFIg/PaymentSP" target="_blank" class="bg-green-500 hover:bg-green-600 text-white font-bold text-xl py-6 px-12 rounded-full shadow-lg transition text-center min-w-[280px]">תשלום אחד מוזל</a>
                <a href="https://secure.cardcom.solutions/EA/EA5/J6zWwGdeqU3Kswh9zpNww/PaymentSP" target="_blank" class="bg-blue-600 hover:bg-blue-700 text-white font-bold text-xl py-6 px-12 rounded-full shadow-lg border-2 border-blue-400 transition text-center min-w-[280px]">פריסה ל-12 תשלומים</a>
            </div>
        </div>
    </section>

    <!-- The Offer & Target Audience with Images -->
    <section class="py-16 bg-white">
        <div class="container mx-auto px-4 max-w-6xl grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
            <div>
                <h2 class="text-3xl font-bold text-blue-900 mb-6">למי מיועדת התוכנית?</h2>
                <p class="text-lg text-gray-700 leading-relaxed mb-6">
                    למאמני כושר, מדריכי יוגה ופילאטיס, או אנשים העוסקים בכל מקצוע בתחום האימון. התוכנית מתאימה גם לאנשים המעוניינים לשנות קריירה, להתמקצע בתזונה ולהפוך ליועצים, מרצים או מנחי סדנאות בתחום.
                </p>
                <ul class="space-y-4 text-gray-700 mb-8">
                    <li class="flex gap-3"><span class="text-green-500 font-bold">✓</span> תלמדו איך ללוות לקוחות בתהליכי שינוי ולגרום להם להתמיד.</li>
                    <li class="flex gap-3"><span class="text-green-500 font-bold">✓</span> תבנו מעטפת ללקוחות שתשאיר אותם נאמנים לאורך זמן.</li>
                    <li class="flex gap-3"><span class="text-green-500 font-bold">✓</span> תיישמו כלי NLP להנעת אנשים לפעולה ויצירת מחויבות אמיתית.</li>
                </ul>
            </div>
            <div class="grid grid-cols-2 gap-4">
                <img src={`${import.meta.env.BASE_URL}/images/more/consult1.jpg`} alt="אימון אישי" class="rounded-xl shadow-md w-full h-48 object-cover">
                <img src={`${import.meta.env.BASE_URL}/images/more/consult2.jpg`} alt="ייעוץ והדרכה" class="rounded-xl shadow-md w-full h-48 object-cover translate-y-6">
            </div>
        </div>
    </section>

    <!-- Structure -->
    <section class="py-12 bg-blue-50 border-t border-b border-blue-100">
        <div class="container mx-auto px-4 max-w-4xl text-center">
            <h2 class="text-2xl font-bold text-blue-900 mb-6">מבנה ההכשרה</h2>
            <ul class="flex flex-col md:flex-row justify-center gap-8 text-gray-800 font-medium text-lg">
                <li class="flex items-center justify-center gap-2">⏱️ 24 מפגשים, 4 שעות (96 שעות)</li>
                <li class="flex items-center justify-center gap-2">📋 12 שנות לימוד וראיון אישי</li>
                <li class="flex items-center justify-center gap-2">🎓 הסמכה מוכרת לביטוח מקצועי</li>
            </ul>
        </div>
    </section>

    <!-- What you get -->
    <section class="py-16 bg-white">
        <div class="container mx-auto px-4 max-w-5xl">
            <h2 class="text-3xl font-bold text-center text-blue-900 mb-12">מה תקבלו בקורס?</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div class="bg-gray-50 p-6 rounded-lg shadow-sm border border-gray-100 flex gap-4 items-center">
                    <span class="text-3xl">📚</span> <p class="font-medium text-gray-800">ידע מקיף ומקצועי בתזונה ופיזיולוגיה.</p>
                </div>
                <div class="bg-gray-50 p-6 rounded-lg shadow-sm border border-gray-100 flex gap-4 items-center">
                    <span class="text-3xl">👨‍⚕️</span> <p class="font-medium text-gray-800">הרצאות אורח מרופאים מובילים בתחומם.</p>
                </div>
                <div class="bg-gray-50 p-6 rounded-lg shadow-sm border border-gray-100 flex gap-4 items-center">
                    <span class="text-3xl">🧠</span> <p class="font-medium text-gray-800">היכרות מעמיקה עם שיטות וגישת ה-NLP.</p>
                </div>
                <div class="bg-gray-50 p-6 rounded-lg shadow-sm border border-gray-100 flex gap-4 items-center">
                    <span class="text-3xl">🔬</span> <p class="font-medium text-gray-800">לימוד פרקטי של פענוח בדיקות דם.</p>
                </div>
                <div class="bg-gray-50 p-6 rounded-lg shadow-sm border border-gray-100 flex gap-4 items-center">
                    <span class="text-3xl">🏃</span> <p class="font-medium text-gray-800">התאמת תזונה מיטבית לסוג הפעילות הגופנית.</p>
                </div>
                <div class="bg-gray-50 p-6 rounded-lg shadow-sm border border-gray-100 flex gap-4 items-center">
                    <span class="text-3xl">🎯</span> <p class="font-medium text-gray-800">כלים להצבת מטרות והתמודדות עם אכילה רגשית.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Bonuses -->
    <section class="py-16 bg-blue-900 text-white">
        <div class="container mx-auto px-4 max-w-6xl">
            <h2 class="text-3xl font-bold text-center text-yellow-400 mb-12">בונוסים מיוחדים למשתתפי הקורס</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                <div class="bg-blue-800 p-6 rounded-xl border border-blue-700 shadow-md">
                    <h3 class="text-xl font-bold text-yellow-300 mb-2">סוכרת? לא תודה</h3>
                    <p class="text-gray-300">עותק מספרו של איציק וקסלר "הקוד הסוכרתי" יישלח אליכם מיד בתום הקורס.</p>
                </div>
                <div class="bg-blue-800 p-6 rounded-xl border border-blue-700 shadow-md">
                    <h3 class="text-xl font-bold text-yellow-300 mb-2">איך קוראים את זה?</h3>
                    <p class="text-gray-300">חוברת מפורטת ומקצועית ללימוד והבנה כיצד לפענח בדיקות דם בקליניקה.</p>
                </div>
                <div class="bg-blue-800 p-6 rounded-xl border border-blue-700 shadow-md">
                    <h3 class="text-xl font-bold text-yellow-300 mb-2">מה נאכל היום?</h3>
                    <p class="text-gray-300">קובץ ענק של מתכונים בריאים ומגוונים להעברה ללקוחות שלכם.</p>
                </div>
                <div class="bg-blue-800 p-6 rounded-xl border border-blue-700 shadow-md">
                    <h3 class="text-xl font-bold text-yellow-300 mb-2">עם מי אפשר לדבר?</h3>
                    <p class="text-gray-300">כניסה לקהילת הבוגרים - קבוצת וואטסאפ סגורה והשתלמות אונליין אחת לחודשיים.</p>
                </div>
                <div class="bg-blue-800 p-6 rounded-xl border border-blue-700 shadow-md">
                    <h3 class="text-xl font-bold text-yellow-300 mb-2">איך מתחילים?</h3>
                    <p class="text-gray-300">שאלון מקיף ומקצועי מוכן מראש, שיעזור לכם בפגישת אבחון ראשונה עם לקוחות.</p>
                </div>
                <div class="bg-blue-800 p-6 rounded-xl border border-blue-700 shadow-md">
                    <h3 class="text-xl font-bold text-yellow-300 mb-2">דילמה מקצועית?</h3>
                    <p class="text-gray-300">מפגש סופרוויז'ן (הדרכה) אישי אחד על אחד עם צוות המכון לאחר סיום הקורס.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Certification & NLP Explanation -->
    <section class="py-16 bg-white">
        <div class="container mx-auto px-4 max-w-5xl text-center">
            <h2 class="text-3xl font-bold text-blue-900 mb-6">תעודת הסמכה ותוצאות</h2>
            <p class="text-lg text-gray-700 mb-10 max-w-3xl mx-auto">
                לעומדים בדרישות הקורס (ציון מעל 65 במבחן הסיום) תינתן תעודת <strong>'יועץ בריאות במגמת תזונה ו-NLP'</strong> מטעם מכון וקסלר.
            </p>
            
            <div class="bg-gray-50 p-8 rounded-2xl text-right mb-12 shadow-sm border border-gray-100">
                <h3 class="text-2xl font-bold text-blue-800 mb-4">מה זה בעצם NLP?</h3>
                <p class="text-gray-700 leading-relaxed">
                    ראשי תיבות של Neuro Linguistic Programming (שפת תכנות עצבית). זוהי גישה המציעה כלים ייחודיים ליצירת שינוי מהיר בצורת החשיבה, דרך הבנת השפה והתנהגות האדם. בקורס אנו מחברים את הכלים האלו ישירות לעולם התזונה והאכילה הרגשית כדי לייצר שינויים שמחזיקים מעמד.
                </p>
            </div>
        </div>
    </section>

    <!-- Videos -->
    <section class="py-16 bg-gray-50">
        <div class="container mx-auto px-4 max-w-6xl">
            <h2 class="text-3xl font-bold text-center text-blue-900 mb-12">הצצה לשיעורים וההכשרות שלנו</h2>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                <div class="aspect-video rounded-xl overflow-hidden shadow-lg">
                    <iframe width="100%" height="100%" src="https://www.youtube.com/embed/TYRtu5WGsP8" frameborder="0" allowfullscreen></iframe>
                </div>
                <div class="aspect-[9/16] rounded-xl overflow-hidden shadow-lg mx-auto w-3/4 md:w-full">
                    <iframe width="100%" height="100%" src="https://www.youtube.com/embed/jjFb9WbAY14" frameborder="0" allowfullscreen></iframe>
                </div>
                <div class="aspect-video rounded-xl overflow-hidden shadow-lg">
                    <iframe width="100%" height="100%" src="https://www.youtube.com/embed/2IOKp1QtG80" frameborder="0" allowfullscreen></iframe>
                </div>
            </div>
        </div>
    </section>

    <!-- Bottom CTA -->
    <section class="py-20 bg-blue-900 text-center">
        <div class="container mx-auto px-4">
            <h2 class="text-3xl font-bold text-white mb-4">הגיע הזמן לתת ללקוחות פתרון שלם</h2>
            <p class="text-xl text-blue-200 mb-10">ולשמור אותם איתכם לאורך זמן!</p>
            <div class="flex flex-col sm:flex-row gap-6 justify-center">
                <!-- כפתורים מורחבים ומרווחים -->
                <a href="https://secure.cardcom.solutions/EA/EA5/FVNYwke6DU6l3QQWv5kFIg/PaymentSP" target="_blank" class="bg-green-500 hover:bg-green-600 text-white font-bold text-xl py-6 px-12 rounded-full shadow-xl transform hover:-translate-y-1 transition text-center min-w-[280px]">
                    לרכישה בתשלום אחד מוזל
                </a>
                <a href="https://secure.cardcom.solutions/EA/EA5/J6zWwGdeqU3Kswh9zpNww/PaymentSP" target="_blank" class="bg-blue-600 hover:bg-blue-700 text-white font-bold text-xl py-6 px-12 rounded-full shadow-xl border-2 border-blue-400 transform hover:-translate-y-1 transition text-center min-w-[280px]">
                    לרכישה בפריסה ל-12 תשלומים
                </a>
            </div>
        </div>
    </section>
</Layout>