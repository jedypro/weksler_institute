---
import Layout from '../../layouts/Layout.astro';
---
<Layout title="קורס ניקוי רעלים - מכון וקסלר">
    <!-- Hero Section (Button color changed) -->
    <section class="bg-blue-900 text-white py-20 text-center relative">
        <div class="container mx-auto px-4 relative z-10 max-w-5xl">
            <div class="inline-block bg-white text-blue-900 font-bold px-6 py-2 rounded-full mb-6">התוכנית המעשית "זורמים לשינוי"</div>
            <h1 class="text-5xl md:text-6xl font-bold mb-6 text-teal-400">קורס ניקוי רעלים</h1>
            <p class="text-2xl mb-8 leading-relaxed max-w-3xl mx-auto font-light">
                ״ב-7 שבועות הורדתי 10 ק״ג, אני פחות משתוקקת לסוכר וחיי השתנו בזכותך״
            </p>
            <p class="text-xl mb-10">איך תרדו במשקל ותהיו מאוזנים מבחינה בריאותית? הצטרפו למאות שכבר עשו זאת!</p>
            <!-- כפתור מורחב ותוקן צבע -->
            <a href="https://secure.cardcom.solutions/EA/EA5/l3MopPY1W0CEnqRUJDEwVw/Order" target="_blank" class="inline-block bg-teal-500 hover:bg-teal-400 text-white font-bold text-xl py-6 px-14 rounded-full shadow-lg transform hover:-translate-y-1 transition duration-300">
                לחצו כאן להצטרפות לתוכנית
            </a>
        </div>
    </section>

    <!-- The Problem & Solution with Image -->
    <section class="py-16 bg-white">
        <div class="container mx-auto px-4 max-w-6xl grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
            <div class="space-y-6">
                <h2 class="text-4xl font-bold text-red-600 mb-2">זה לא באשמתכם!</h2>
                <p class="text-lg text-gray-800">במודע או שלא במודע, אנחנו מכניסים לגוף שלנו רעלים שגורמים לנו לרצות לאכול – גם אם אנחנו בכלל לא רעבים.</p>
                <p class="font-bold text-xl text-blue-900">זה לא קשור לכוח הרצון שלכם!</p>
                <p class="text-gray-700">כל פעם שאנחנו שוברים לעצמנו את המילה, מפרים הבטחה ושוב אוכלים מזון רעיל, מעובד או סוכרי - זה אך ורק בגלל שהמוח שלנו פיתח תלות, ואין לנו שום יכולת החלטה.</p>
                <hr class="border-gray-200 my-4">
                <h3 class="text-2xl font-bold text-teal-600">הגיע הזמן לעשות ניקוי יסודי</h3>
                <p class="text-gray-700">
                    מפסיקים לעשות דיאטה שתצליח לזמן קצר, ועושים תהליך ניקוי יסודי אבל פשוט, שמותאם לאנשים עובדים ומתמקד אך ורק בדבר אחד: ניקוי הרעלים, הורדת החשקים למתוק, וניתוק מוחלט של התלות בסוכרים.
                </p>
            </div>
            <div>
                <<img src={`${import.meta.env.BASE_URL}images/more/detox1.webp`}" alt="תזונה בריאה מנקה רעלים" class="rounded-2xl shadow-xl w-full object-cover">
            </div>
        </div>
    </section>

    <!-- How it works with Image -->
    <section class="py-16 bg-gray-50 border-t border-gray-200">
        <div class="container mx-auto px-4 max-w-6xl grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
            <div class="order-2 lg:order-1">
                <<img src={`${import.meta.env.BASE_URL}images/more/detox2.jpg`}" alt="צוות יועצי תזונה" class="rounded-2xl shadow-xl w-full object-cover">
            </div>
            <div class="order-1 lg:order-2">
                <h2 class="text-3xl font-bold text-blue-900 mb-8">איך זה עובד? אין פשוט מזה!</h2>
                <div class="space-y-6">
                    <div class="bg-white p-6 rounded-xl shadow-sm border border-gray-100 flex gap-4">
                        <div class="text-teal-500 text-3xl">📅</div>
                        <div>
                            <h3 class="text-lg font-bold mb-1">תוכנית מסודרת ל-7 שבועות</h3>
                            <p class="text-gray-600 text-sm">התוכנית מבוססת על שילוב של תפריטים מדויקים לכל שבוע, הדרכה אישית, ותוכנית אימונים מומלצת.</p>
                        </div>
                    </div>
                    <div class="bg-white p-6 rounded-xl shadow-sm border border-gray-100 flex gap-4">
                        <div class="text-teal-500 text-3xl">🛒</div>
                        <div>
                            <h3 class="text-lg font-bold mb-1">רשימת קניות שבועית</h3>
                            <p class="text-gray-600 text-sm">כל שבוע ייפתח לך התוכן לאותו שבוע: מה לעשות בדיוק, כולל רשימת קניות מדויקת.</p>
                        </div>
                    </div>
                    <div class="bg-white p-6 rounded-xl shadow-sm border border-gray-100 flex gap-4">
                        <div class="text-teal-500 text-3xl">♾️</div>
                        <div>
                            <h3 class="text-lg font-bold mb-1">גישה לכל החיים</h3>
                            <p class="text-gray-600 text-sm">מרגישים אחרי 3 שבועות שצריך הפסקה? התוכנית פתוחה לכם לכל החיים ותוכלו לחזור אליה תמיד.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Results -->
    <section class="py-16 bg-gray-100 border-b border-gray-200">
        <div class="container mx-auto px-4 max-w-4xl text-center">
            <h2 class="text-3xl font-bold mb-8 text-blue-900">מה יקרה בתוכנית?</h2>
            <ul class="text-xl space-y-4 text-right inline-block mx-auto font-medium text-gray-800 bg-white p-8 rounded-xl shadow-sm border border-gray-200">
                <li class="flex items-center gap-3"><span class="text-green-500">✅</span> תחזרו הביתה והיד שלכם לא תלך אוטומטית לעוגות על השיש.</li>
                <li class="flex items-center gap-3"><span class="text-green-500">✅</span> כשתזמינו ב-wolt, האצבע שלכם לא תלך אוטומטית לפיצות ולגלידות.</li>
                <li class="flex items-center gap-3"><span class="text-green-500">✅</span> תפסיקו לומר ״איך שוב ב-22:00 בלילה אכלתי שטויות מול הנטפליקס?״</li>
                <li class="flex items-center gap-3"><span class="text-green-500">✅</span> תיצרו לעצמכם שגרה בריאה ויציבה גם לאחר סיום התוכנית.</li>
            </ul>
        </div>
    </section>

    <!-- Videos -->
    <section class="py-16 bg-white">
        <div class="container mx-auto px-4 max-w-5xl">
            <h2 class="text-3xl font-bold text-center text-blue-900 mb-12">הכירו את התהליך שלנו</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                <div class="aspect-video rounded-xl overflow-hidden shadow-lg">
                    <iframe width="100%" height="100%" src="https://www.youtube.com/embed/iCcO36KIsuE" frameborder="0" allowfullscreen></iframe>
                </div>
                <div class="aspect-video rounded-xl overflow-hidden shadow-lg">
                    <iframe width="100%" height="100%" src="https://www.youtube.com/embed/Y6wUzOdeVcM" frameborder="0" allowfullscreen></iframe>
                </div>
            </div>
        </div>
    </section>

    <!-- FAQ -->
    <section class="py-16 bg-gray-50">
        <div class="container mx-auto px-4 max-w-4xl">
            <h2 class="text-3xl font-bold text-center text-blue-900 mb-12">שאלות נפוצות</h2>
            <div class="space-y-6">
                <div class="bg-white p-6 rounded-lg shadow-sm border border-gray-100">
                    <h3 class="font-bold text-lg text-teal-600 mb-2">מה קורה לאחר התשלום?</h3>
                    <p class="text-gray-600">לאחר התשלום תועבר לדף בו תתבקש למלא כתובת מייל, אליה ישלחו פרטי הגישה לתוכנית באופן אוטומטי תוך 5 דקות.</p>
                </div>
                <div class="bg-white p-6 rounded-lg shadow-sm border border-gray-100">
                    <h3 class="font-bold text-lg text-teal-600 mb-2">תוך כמה זמן אני כבר מתחיל לראות תוצאות?</h3>
                    <p class="text-gray-600">ניקוי רעלים מלמד את הגוף לעבוד על רקמת השומן. כל אדם מגיב שונה, אך ניתן להתחיל לראות תוצאות משמעותיות כבר מהשבוע השני.</p>
                </div>
                <div class="bg-white p-6 rounded-lg shadow-sm border border-gray-100">
                    <h3 class="font-bold text-lg text-teal-600 mb-2">האם זה מתאים למי שיש בעיות בריאותיות או שנוטל כדורים קבוע?</h3>
                    <p class="text-gray-600">בהחלט כן. התוכנית אינה טיפולית רפואית, אך תלמדו כיצד להתאים את הכלים לאורח החיים ולמצב הבריאותי שלכם.</p>
                </div>
                <div class="bg-white p-6 rounded-lg shadow-sm border border-gray-100">
                    <h3 class="font-bold text-lg text-teal-600 mb-2">האם התוכנית תעזור לי גם להוריד את השומן הבטני?</h3>
                    <p class="text-gray-600 font-bold text-xl">כן!</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Bottom CTA (Button color changed) -->
    <section class="py-20 bg-blue-900 text-center">
        <div class="container mx-auto px-4">
            <h2 class="text-3xl font-bold text-white mb-10">זה הזמן להתנקות ולהתחיל מחדש</h2>
            <!-- כפתור מורחב ותוקן צבע -->
            <a href="https://secure.cardcom.solutions/EA/EA5/l3MopPY1W0CEnqRUJDEwVw/Order" target="_blank" class="inline-block bg-teal-500 hover:bg-teal-400 text-white font-bold text-2xl py-6 px-14 rounded-full shadow-xl transform hover:scale-105 transition duration-300">
                הירשמו עכשיו לניקוי רעלים
            </a>
        </div>
    </section>
</Layout>