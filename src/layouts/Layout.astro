---
import '../styles/global.css';
const { title } = Astro.props;
---
<html lang="he" dir="rtl">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{title}</title>
    <link href="https://fonts.googleapis.com/css2?family=Heebo:wght@300;400;700&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Heebo', sans-serif; scroll-behavior: smooth; }
    </style>
</head>
<body class="bg-gray-50 text-gray-800 relative flex flex-col min-h-screen">
    <nav class="bg-blue-900 text-white p-4 shadow-md sticky top-0 z-40">
        <div class="container mx-auto flex justify-between items-center max-w-7xl">
            <a href="/" class="shrink-0 transition hover:opacity-90">
                <img src="/images/לוגו.jpg" alt="מכון וקסלר" class="h-14 object-contain" style="-webkit-mask-image: radial-gradient(ellipse 90% 90% at 50% 50%, black 70%, transparent 100%); mask-image: radial-gradient(ellipse 90% 90% at 50% 50%, black 70%, transparent 100%);">
            </a>
            <div class="flex gap-6 text-lg font-medium">
                <a href="/" class="hover:text-blue-300 transition">ראשי</a>
                <a href="/about" class="hover:text-blue-300 transition">על המכון</a>
                <a href="/courses" class="hover:text-blue-300 transition">קורסים</a>
                <a href="/book" class="hover:text-blue-300 transition">הספר</a>
                <a href="/#contact" class="hover:text-blue-300 transition">צור קשר</a>
            </div>
        </div>
    </nav>
    
    <main class="flex-grow">
        <slot />
    </main>

    <footer class="bg-gray-900 text-white pt-16 pb-8 border-t-4 border-blue-600">
        <div class="container mx-auto px-4 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10 max-w-7xl mb-12 border-b border-gray-700 pb-12">
            
            <!-- Contact Info -->
            <div class="space-y-4">
                <img src="/images/לוגו כהה.png" alt="מכון וקסלר" class="h-24 object-contain mb-4">
                <p class="text-gray-300 flex items-center gap-3">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16"><path d="M8 16s6-5.686 6-10A6 6 0 0 0 2 6c0 4.314 6 10 6 10zm0-7a3 3 0 1 1 0-6 3 3 0 0 1 0 6z"/></svg>
                    דניאל ינובסקי 6, ירושלים
                </p>
                <div class="text-gray-300 pt-4 border-t border-gray-700 space-y-3">
                    <p class="flex items-center gap-3">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16"><path d="M3 2a2 2 0 0 1 2-2h6a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2zm6 11a1 1 0 1 0-2 0 1 1 0 0 0 2 0"/></svg>
                        <span dir="ltr">050-8375753</span>
                    </p>
                    <p class="flex items-center gap-3">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16"><path d="M3.654 1.328a.678.678 0 0 0-1.015-.063L1.605 2.3c-.483.484-.661 1.169-.45 1.77a17.568 17.568 0 0 0 4.168 6.608 17.569 17.569 0 0 0 6.608 4.168c.601.211 1.286.033 1.77-.45l1.034-1.034a.678.678 0 0 0-.063-1.015l-2.307-1.794a.678.678 0 0 0-.58-.122l-2.19.547a1.745 1.745 0 0 1-1.657-.459L5.482 8.062a1.745 1.745 0 0 1-.46-1.657l.548-2.19a.678.678 0 0 0-.122-.58L3.654 1.328z"/></svg>
                        <span dir="ltr">03-333333</span>
                    </p>
                    <p class="flex items-center gap-3">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16"><path d="M.05 3.555A2 2 0 0 1 2 2h12a2 2 0 0 1 1.95 1.555L8 8.414.05 3.555ZM0 4.697v7.104l5.803-3.558L0 4.697ZM6.761 8.83l-6.57 4.027A2 2 0 0 0 2 14h12a2 2 0 0 0 1.808-1.144l-6.57-4.027L8 9.586l-1.239-.757Zm3.436-.586L16 11.801V4.697l-5.803 3.546Z"/></svg>
                        <a href="mailto:Wekslerinstitute@gmail.com" class="hover:text-blue-400 transition">Wekslerinstitute@gmail.com</a>
                    </p>
                </div>
            </div>

            <!-- Quick Navigation -->
            <div>
                <h4 class="text-xl font-bold mb-6 text-blue-400">ניווט מהיר</h4>
                <ul class="space-y-3 text-gray-300">
                    <li><a href="/" class="hover:text-white hover:translate-x-1 inline-block transition transform">ראשי</a></li>
                    <li><a href="/about" class="hover:text-white hover:translate-x-1 inline-block transition transform">על המכון והמרצים</a></li>
                    <li><a href="/courses" class="hover:text-white hover:translate-x-1 inline-block transition transform">קורסים והכשרות</a></li>
                    <li><a href="/book" class="hover:text-white hover:translate-x-1 inline-block transition transform">ספר הקוד הסוכרתי</a></li>
                    <li><a href="/#contact" class="hover:text-white hover:translate-x-1 inline-block transition transform">צור קשר</a></li>
                </ul>
            </div>

            <!-- Legal -->
            <div>
                <h4 class="text-xl font-bold mb-6 text-blue-400">מידע משפטי</h4>
                <ul class="space-y-3 text-gray-300">
                    <li><a href="/accessibility" class="hover:text-white hover:translate-x-1 inline-block transition transform">הצהרת נגישות</a></li>
                    <li><a href="/terms" class="hover:text-white hover:translate-x-1 inline-block transition transform">תנאי שימוש</a></li>
                    <li><a href="/privacy" class="hover:text-white hover:translate-x-1 inline-block transition transform">מדיניות פרטיות</a></li>
                                 </ul>
            </div>

            <!-- Social Media -->
